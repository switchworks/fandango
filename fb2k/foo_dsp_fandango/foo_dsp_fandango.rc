#include "resource.h"
#include "winres.h"

LANGUAGE LANG_ENGLISH, SUBLANG_ENGLISH_US
#pragma code_page(1252)

IDD_DSP_SPREAD DIALOGEX 0, 0, 284, 120
STYLE DS_SETFONT | DS_MODALFRAME | DS_FIXEDSYS | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "fandango spread"
FONT 8, "MS Shell Dlg", 400, 0, 0x1
BEGIN
    LTEXT           "Expander",IDC_STATIC,12,8,60,8
    CONTROL         "",IDC_SLIDER_EXPANDER,"msctls_trackbar32",TBS_BOTH | TBS_NOTICKS | WS_TABSTOP,12,18,200,18
    CTEXT           "66%",IDC_LABEL_EXPANDER,216,22,56,8
    LTEXT           "Center mix",IDC_STATIC,12,42,60,8
    CONTROL         "",IDC_SLIDER_CENTER,"msctls_trackbar32",TBS_BOTH | TBS_NOTICKS | WS_TABSTOP,12,52,200,18
    CTEXT           "100%",IDC_LABEL_CENTER,216,56,56,8
    CONTROL         "Bypass",IDC_CHECK_BYPASS,"Button",BS_AUTOCHECKBOX | WS_TABSTOP,12,78,60,10
    CONTROL         "Inverse",IDC_CHECK_INVERSE,"Button",BS_AUTOCHECKBOX | WS_TABSTOP,80,78,60,10
    PUSHBUTTON      "Reset",IDC_RESET,12,98,50,14
    DEFPUSHBUTTON   "OK",IDOK,172,98,50,14
    PUSHBUTTON      "Cancel",IDCANCEL,226,98,50,14
END

